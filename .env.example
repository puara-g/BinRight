# Gemini API 키 (https://aistudio.google.com 에서 무료 발급). 없으면 'AI에게 물어보기'만 꺼지고 나머지는 동작해요.
GEMINI_API_KEY=
PORT=3000
GEMINI_MODEL=gemini-3.5-flash-lite

# 공공데이터포털 인증키 (https://www.data.go.kr → '행정안전부_생활쓰레기배출정보' 활용신청, 개발계정 자동승인)
# 없으면 지역 데이터는 시연용 예시 6곳만 보여요.
DATA_GO_KR_API_KEY=

# 카카오 REST API 키 (https://developers.kakao.com → 내 애플리케이션 → 앱 키, '카카오맵' 사용 설정 ON)
# 없으면 혜택 탭의 '근처 수거·교환 장소'가 꺼지고 일반 안내만 보여요.
KAKAO_REST_API_KEY=
